// Fleet Management - Vehicles
model Vehicle {
  id             String   @id @default(cuid())
  registration   String   @unique
  type           String   // matatu, bus, truck, van, lorry, motorcycle
  model          String
  manufacturer   String
  year           Int
  capacity       Int      // passenger or cargo capacity
  fuelType       String   // diesel, petrol, electric, hybrid
  status         String   // active, maintenance, retired, accident
  currentMileage Int      @default(0)
  insuranceExpiry DateTime?
  inspectionExpiry DateTime?
  routeId        String?
  assignedDriver String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  route          TransportRoute? @relation(fields: [routeId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  fuelLogs       FuelLog[]
  maintenance    MaintenanceRecord[]
  trips          Trip[]
  
  // Add these missing relations
  schedules      Schedule[]        // Opposite of Schedule.vehicle
  assignments    DriverAssignment[] // Opposite of DriverAssignment.vehicle
  fuelEfficiencies FuelEfficiency[] // Opposite of FuelEfficiency.vehicle
}

model TransportRoute {
  id             String   @id @default(cuid())
  name           String   // e.g., "Ruiru - Nairobi CBD"
  code           String   @unique
  startPoint     String
  endPoint       String
  distanceKm     Float
  estimatedTime  Int      // minutes
  stops          Json?    // Array of stop points
  fare           Float    // base fare
  farePerKm      Float?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicles       Vehicle[]
  schedules      Schedule[]
  trips          Trip[]
  
  // Add these missing relations
  assignments    DriverAssignment[] // Opposite of DriverAssignment.route
  trafficData    TrafficData[]     // Opposite of TrafficData.route
}

// Schedules (Matatu Schedule)
model Schedule {
  id             String   @id @default(cuid())
  routeId        String
  vehicleId      String
  departureTime  String   // "06:00:00"
  arrivalTime    String   // "07:30:00"
