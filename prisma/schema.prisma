  licenseNumber  String   @unique
  licenseClass   String   // B, C, D, E, PSV
  phone          String
  email          String?
  address        String?
  hireDate       DateTime
  status         String   // active, on_leave, suspended, terminated
  rating         Float    @default(0)
  totalTrips     Int      @default(0)
  accidents      Int      @default(0)
  salary         Float?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization     @relation(fields: [organizationId], references: [id])
  assignments    DriverAssignment[]
  trips          Trip[]
  fuelLogs       FuelLog[]
}

// Driver Assignment to Vehicle/Route
model DriverAssignment {
  id             String   @id @default(cuid())
  driverId       String
  vehicleId      String
  routeId        String?
  assignedDate   DateTime @default(now())
  endDate        DateTime?
  shift          String   // morning, afternoon, night, full
  status         String   @default("active")
  organizationId String
  
  driver         Driver         @relation(fields: [driverId], references: [id])
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  route          TransportRoute? @relation(fields: [routeId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

// Trips/Manifest
model Trip {
  id             String   @id @default(cuid())
  tripNumber     String   @unique
  vehicleId      String
  driverId       String
  routeId        String
  conductorName  String?  // for matatu
  passengerCount Int      @default(0)
  revenue        Float    @default(0)
  distance       Float
  startTime      DateTime
  endTime        DateTime?
  status         String   // scheduled, in_progress, completed, cancelled
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id])
  driver         Driver         @relation(fields: [driverId], references: [id])
  route          TransportRoute @relation(fields: [routeId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  payments       TripPayment[]
}

// Trip Payments (Revenue per trip)
model TripPayment {
  id             String   @id @default(cuid())
  tripId         String
  amount         Float
  paymentMethod  String   // cash, mpesa, card, saccos
  transactionRef String?
  collectedBy    String
  organizationId String
  createdAt      DateTime @default(now())
  
  trip           Trip         @relation(fields: [tripId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// Fuel Tracking
model FuelLog {
  id             String   @id @default(cuid())
  vehicleId      String
  driverId       String?
  date           DateTime @default(now())
  liters         Float
  costPerLiter   Float
  totalCost      Float
  odometer       Int
  fuelType       String   // diesel, petrol
  station        String?
  receiptNumber  String?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  driver         Driver?      @relation(fields: [driverId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// Fuel Efficiency Tracking
model FuelEfficiency {
  id             String   @id @default(cuid())
  vehicleId      String
  periodStart    DateTime
  periodEnd      DateTime
  totalFuel      Float
  totalDistance  Int
  efficiency     Float    // km per liter
  costPerKm      Float
  organizationId String
  createdAt      DateTime @default(now())
  
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  @@unique([vehicleId, periodStart])
}

// Maintenance Records
model MaintenanceRecord {
  id             String   @id @default(cuid())
  vehicleId      String
  maintenanceDate DateTime
  type           String   // routine, repair, emergency, service
  description    String
  cost           Float
  odometer       Int
  mechanic       String?
  nextDueDate    DateTime?
  nextDueOdometer Int?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// Route Optimization - Traffic Data
model TrafficData {
  id             String   @id @default(cuid())
  routeId        String
  dayOfWeek      Int      // 1-7 (Monday-Sunday)
  hourOfDay      Int      // 0-23
  typicalDuration Int     // minutes
  congestionLevel String  // low, medium, high, severe
  averageSpeed   Float    // km/h
  organizationId String
  recordedAt     DateTime @default(now())
  
  route          TransportRoute @relation(fields: [routeId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  
  @@unique([routeId, dayOfWeek, hourOfDay])
}