generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Industry {
  id        String   @id @default(cuid())
  name      String   @unique
  key       String   @unique
  icon      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  modules        Module[]
  organizations  Organization[]
  roles          Role[]
}

model Module {
  id          String   @id @default(cuid())
  industryId  String
  name        String
  key         String   @unique
  icon        String
  color       String
  isCore      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  industry           Industry                @relation(fields: [industryId], references: [id])
  organizationModules OrganizationModule[]
  userRoles          UserRoleAssignment[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String
  phone     String?
  orgCode   String   @unique
  industryId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  industry            Industry              @relation(fields: [industryId], references: [id])
  settings            OrganizationSettings?
  users               User[]
  modules             OrganizationModule[]
  branches            Branch[]
  suppliers           Supplier[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  lowStockAlerts      LowStockAlert[]
  purchaseRequests    PurchaseRequest[]
  purchaseOrders      PurchaseOrder[]
  goodsReceiptNotes   GoodsReceiptNote[]
  reorderSuggestions  ReorderSuggestion[]
  supplierPriceHistory SupplierPriceHistory[]
  supplierPerformance SupplierPerformance[]
  supplierOrderHistory SupplierOrderHistory[]
  supplierDeliveries  SupplierDelivery[]
  interBranchDeliveries InterBranchDelivery[]
  deliveryAlerts      DeliveryAlert[]
  deliveryCalendars   DeliveryCalendar[]
  priceTrends         PriceTrend[]
  demandForecasts     DemandForecast[]
  stockoutRisks       StockoutRisk[]
  wastageRecords      WastageRecord[]
  bulkOrderSavings    BulkOrderSaving[]
  spendingAnomalies   SpendingAnomaly[]
  co2Emissions        CO2Emission[]
  localSupplierScores LocalSupplierScore[]
  packagingWastes     PackagingWaste[]
  wasteReductionSuggestions WasteReductionSuggestion[]
  medicalInventory    MedicalInventory[]
  coldChainLogs       ColdChainLog[]
  expiryAlerts        ExpiryAlert[]
  emergencyReorders   EmergencyReorder[]
  bookInventory       BookInventory[]
  bookDistributions   BookDistribution[]
  stationeryItems     StationeryItem[]
  uniformItems        UniformItem[]
  cafeteriaSupplies   CafeteriaSupply[]
  mealConsumptions    MealConsumption[]
  hostelSupplies      HostelSupply[]
  roomAllocations     RoomAllocation[]
  retailProducts      RetailProduct[]
  retailSales         RetailSale[]
  retailTransfers     RetailTransfer[]
  reorderEngines      ReorderEngine[]
  promotions          Promotion[]
  loyaltyCustomers    LoyaltyCustomer[]
  loyaltyTransactions LoyaltyTransaction[]
  
  // Manufacturing relations
  rawMaterials        RawMaterial[]
  rawMaterialMovements RawMaterialMovement[]
  productionInputs    ProductionInput[]
  workOrders          WorkOrder[]
  finishedGoodsOutputs FinishedGoodsOutput[]
  finishedGoods       FinishedGoods[]
  dispatches          Dispatch[]
  dispatchItems       DispatchItem[]
  
  // Logistics & Transport relations
  vehicles            Vehicle[]
  transportRoutes     TransportRoute[]
  schedules           Schedule[]
  drivers             Driver[]
  driverAssignments   DriverAssignment[]
  trips               Trip[]
  tripPayments        TripPayment[]
  fuelLogs            FuelLog[]
  fuelEfficiencies    FuelEfficiency[]
  maintenanceRecords  MaintenanceRecord[]
  trafficData         TrafficData[]
}

model OrganizationModule {
  id             String       @id @default(cuid())
  organizationId String
  moduleId       String
  isEnabled      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  module         Module       @relation(fields: [moduleId], references: [id])
  
  @@unique([organizationId, moduleId])
}

model OrganizationSettings {
  id                    String            @id @default(cuid())
  organizationId        String            @unique
  currency              String            @default("KES")
  currencySymbol        String            @default("KSh")
  timezone              String            @default("Africa/Nairobi")
  dateFormat            String            @default("DD/MM/YYYY")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  organization          Organization      @relation(fields: [organizationId], references: [id])
}

model User {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String?
  orgCode        String
  loginCode      String
  organizationId String
  legacyRole     LegacyUserRole @default(STAFF)
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization          @relation(fields: [organizationId], references: [id])
  userRoles      UserRoleAssignment[]
  managedBranches Branch[]             @relation("BranchManager")
  branchStaff    BranchStaff[]
}

enum LegacyUserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  STAFF
}

// ==================== RBAC MODELS ====================

model Role {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String?
  industryId  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  industry    Industry              @relation(fields: [industryId], references: [id])
  permissions RolePermission[]
  userRoles   UserRoleAssignment[]
}

model Permission {
  id          String   @id @default(cuid())
  moduleKey   String
  action      String
  resource    String?
  description String?
  createdAt   DateTime @default(now())
  
  rolePermissions RolePermission[]
  
  @@unique([moduleKey, action, resource])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  
  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  moduleId   String?
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  module     Module?  @relation(fields: [moduleId], references: [id])
  
  @@unique([userId, roleId, moduleId])
  @@map("user_roles")
}

// ==================== MULTI-BRANCH MODELS ====================

model Branch {
  id             String         @id @default(cuid())
  name           String
  code           String         @unique
  organizationId String
  address        String?
  phone          String?
  email          String?
  managerId      String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  organization   Organization   @relation(fields: [organizationId], references: [id])
  manager        User?          @relation("BranchManager", fields: [managerId], references: [id])
  inventory      BranchInventory[]
  procurement    BranchProcurement[]
  deliveries     BranchDelivery[]
  staff          BranchStaff[]
  branchStock    BranchStock[]
  stockMovements StockMovement[]
  lowStockAlerts LowStockAlert[]
  reorderSuggestions ReorderSuggestion[]
  fromDeliveries InterBranchDelivery[] @relation("FromBranch")
  toDeliveries   InterBranchDelivery[] @relation("ToBranch")
  demandForecasts DemandForecast[]
  stockoutRisks  StockoutRisk[]
  wastageRecords WastageRecord[]
  retailBranchStock RetailBranchStock[]
  retailSales     RetailSale[]
  fromTransfers   RetailTransfer[] @relation("FromBranchTransfer")
  toTransfers     RetailTransfer[] @relation("ToBranchTransfer")
  reorderEngines  ReorderEngine[]
  
  // Manufacturing relations
  rawMaterialMovements RawMaterialMovement[]
  rawMaterialBranchStock RawMaterialBranchStock[]
  finishedGoodsBranchStock FinishedGoodsBranchStock[]
  
  @@unique([organizationId, code])
}

model BranchInventory {
  id             String         @id @default(cuid())
  branchId       String
  itemId         String
  currentStock   Float
  minimumStock   Float
  maximumStock   Float
  reorderPoint   Float
  updatedAt      DateTime       @updatedAt
  
  branch         Branch         @relation(fields: [branchId], references: [id])
  
  @@unique([branchId, itemId])
}

model BranchProcurement {
  id              String         @id @default(cuid())
  branchId        String
  purchaseOrderId String
  status          String
  createdAt       DateTime       @default(now())
  
  branch          Branch         @relation(fields: [branchId], references: [id])
}

model BranchDelivery {
  id             String         @id @default(cuid())
  branchId       String
  deliveryId     String
  status         String
  receivedAt     DateTime?
  
  branch         Branch         @relation(fields: [branchId], references: [id])
}

model BranchStaff {
  id             String         @id @default(cuid())
  branchId       String
  userId         String
  role           String
  assignedAt     DateTime       @default(now())
  
  branch         Branch         @relation(fields: [branchId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  
  @@unique([branchId, userId])
}

// ==================== SUPPLIER MODELS ====================

model Supplier {
  id             String         @id @default(cuid())
  name           String
  code           String         @unique
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  paymentTerms   String?
  leadTime       Int?
  rating         Float          @default(0)
  isActive       Boolean        @default(true)
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  organization   Organization   @relation(fields: [organizationId], references: [id])
  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
  priceHistory   SupplierPriceHistory[]
  performance    SupplierPerformance[]
  orderHistory   SupplierOrderHistory[]
  deliveries     SupplierDelivery[]
  priceTrends    PriceTrend[]
  bulkOrderSavings BulkOrderSaving[]
  spendingAnomalies SpendingAnomaly[]
  localSupplierScores LocalSupplierScore[]
  medicalInventory MedicalInventory[]
  bookInventory   BookInventory[]
  stationeryItems StationeryItem[]
  uniformItems    UniformItem[]
  cafeteriaSupplies CafeteriaSupply[]
  hostelSupplies  HostelSupply[]
  retailProducts  RetailProduct[]
  rawMaterials    RawMaterial[]
  
  @@unique([organizationId, code])
}

// ==================== HOSPITALITY INVENTORY MODELS ====================

model InventoryCategory {
  id             String         @id @default(cuid())
  name           String
  description    String?
  color          String?
  icon           String?
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  organization   Organization      @relation(fields: [organizationId], references: [id])
  items          InventoryItem[]
}

model InventoryItem {
  id             String            @id @default(cuid())
  name           String
  sku            String            @unique
  barcode        String?
  description    String?
  categoryId     String
  unit           String
  currentStock   Float             @default(0)
  minimumStock   Float             @default(0)
  maximumStock   Float             @default(0)
  reorderPoint   Float             @default(0)
  costPrice      Float             @default(0)
  sellingPrice   Float             @default(0)
  location       String?
  supplierId     String?
  imageUrl       String?
  isActive       Boolean           @default(true)
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  category       InventoryCategory @relation(fields: [categoryId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  movements      StockMovement[]
  branchStock    BranchStock[]
  lowStockAlerts LowStockAlert[]
  reorderSuggestions ReorderSuggestion[]
  priceHistory   SupplierPriceHistory[]
  priceTrends    PriceTrend[]
  demandForecasts DemandForecast[]
  stockoutRisks  StockoutRisk[]
  wastageRecords WastageRecord[]
  bulkOrderSavings BulkOrderSaving[]
  spendingAnomalies SpendingAnomaly[]
  packagingWastes PackagingWaste[]
}

model StockMovement {
  id             String         @id @default(cuid())
  itemId         String
  branchId       String?
  quantity       Float
  type           MovementType
  reference      String?
  previousStock  Float
  newStock       Float
  notes          String?
  createdBy      String
  organizationId String
  createdAt      DateTime       @default(now())
  
  item           InventoryItem  @relation(fields: [itemId], references: [id])
  branch         Branch?        @relation(fields: [branchId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

enum MovementType {
  RECEIVE
  ISSUE
  ADJUST
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  WASTAGE
}

model BranchStock {
  id             String         @id @default(cuid())
  branchId       String
  itemId         String
  quantity       Float          @default(0)
  reservedStock  Float          @default(0)
  availableStock Float          @default(0)
  updatedAt      DateTime       @updatedAt
  
  branch         Branch         @relation(fields: [branchId], references: [id])
  item           InventoryItem  @relation(fields: [itemId], references: [id])
  
  @@unique([branchId, itemId])
}

model LowStockAlert {
  id             String         @id @default(cuid())
  itemId         String
  branchId       String?
  organizationId String
  currentStock   Float
  reorderPoint   Float
  status         AlertStatus    @default(PENDING)
  notifiedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  
  item           InventoryItem  @relation(fields: [itemId], references: [id])
  branch         Branch?        @relation(fields: [branchId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

enum AlertStatus {
  PENDING
  NOTIFIED
  RESOLVED
  IGNORED
}

// ==================== PROCUREMENT MODELS ====================

model PurchaseRequest {
  id             String              @id @default(cuid())
  requestNumber  String              @unique
  title          String
  description    String?
  requestedBy    String
  requestedDate  DateTime            @default(now())
  requiredDate   DateTime
  items          Json
  status         RequestStatus       @default(DRAFT)
  priority       Priority            @default(MEDIUM)
  approvedBy     String?
  approvedAt     DateTime?
  rejectionReason String?
  budgetCode     String?
  department     String?
  organizationId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  
  organization   Organization        @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ORDERED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PurchaseOrder {
  id               String            @id @default(cuid())
  poNumber         String            @unique
  supplierId       String
  requestId        String?
  orderDate        DateTime          @default(now())
  expectedDate     DateTime
  deliveryDate     DateTime?
  items            Json
  subtotal         Float
  tax              Float             @default(0)
  discount         Float             @default(0)
  total            Float
  status           OrderStatus       @default(SUBMITTED)
  notes            String?
  approvedBy       String?
  approvedAt       DateTime?
  organizationId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  request          PurchaseRequest?  @relation(fields: [requestId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  receipts         GoodsReceiptNote[]
  orderHistory     SupplierOrderHistory[]
  supplierDeliveries SupplierDelivery[]
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SHIPPED
  PARTIAL
  DELIVERED
  CANCELLED
  REJECTED
}

model GoodsReceiptNote {
  id               String            @id @default(cuid())
  grnNumber        String            @unique
  poId             String
  receivedDate     DateTime          @default(now())
  items            Json
  status           ReceiptStatus     @default(PENDING)
  receivedBy       String
  notes            String?
  organizationId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  purchaseOrder    PurchaseOrder     @relation(fields: [poId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
}

enum ReceiptStatus {
  PENDING
  COMPLETE
  PARTIAL
  REJECTED
}

model ReorderSuggestion {
  id               String            @id @default(cuid())
  itemId           String
  branchId         String?
  currentStock     Float
  reorderPoint     Float
  suggestedQty     Float
  reason           String
  status           SuggestionStatus  @default(PENDING)
  createdAt        DateTime          @default(now())
  processedAt      DateTime?
  organizationId   String?
  
  item             InventoryItem     @relation(fields: [itemId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  PROCESSED
}

// ==================== SUPPLIER ENHANCEMENTS ====================

model SupplierPriceHistory {
  id             String   @id @default(cuid())
  supplierId     String
  itemId         String
  previousPrice  Float
  newPrice       Float
  effectiveDate  DateTime @default(now())
  notes          String?
  createdBy      String
  createdAt      DateTime @default(now())
  organizationId String
  
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  item           InventoryItem @relation(fields: [itemId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model SupplierPerformance {
  id             String   @id @default(cuid())
  supplierId     String
  periodStart    DateTime
  periodEnd      DateTime
  onTimeDeliveries Int    @default(0)
  totalDeliveries Int    @default(0)
  onTimeRate     Float    @default(0)
  qualityRating  Float    @default(0)
  avgLeadTime    Float    @default(0)
  responseTime   Float?
  organizationId String
  createdAt      DateTime @default(now())
  
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  @@unique([supplierId, periodStart])
}

model SupplierOrderHistory {
  id             String   @id @default(cuid())
  supplierId     String
  poId           String
  orderDate      DateTime
  deliveryDate   DateTime?
  totalAmount    Float
  status         String
  lateDays       Int?
  organizationId String
  createdAt      DateTime @default(now())
  
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  purchaseOrder  PurchaseOrder @relation(fields: [poId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// ==================== DELIVERY LOGISTICS MODELS ====================

model SupplierDelivery {
  id               String          @id @default(cuid())
  deliveryNumber   String          @unique
  poId             String
  supplierId       String
  expectedDate     DateTime
  actualDate       DateTime?
  status           DeliveryStatus  @default(SCHEDULED)
  trackingNumber   String?
  carrier          String?
  notes            String?
  delayedReason    String?
  notifiedAt       DateTime?
  organizationId   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  purchaseOrder    PurchaseOrder   @relation(fields: [poId], references: [id])
  supplier         Supplier        @relation(fields: [supplierId], references: [id])
  organization     Organization    @relation(fields: [organizationId], references: [id])
  alerts           DeliveryAlert[]
  co2Emissions     CO2Emission[]
}

model InterBranchDelivery {
  id               String          @id @default(cuid())
  deliveryNumber   String          @unique
  fromBranchId     String
  toBranchId       String
  requestNumber    String?
  expectedDate     DateTime
  actualDate       DateTime?
  status           DeliveryStatus  @default(SCHEDULED)
  items            Json
  carrier          String?
  driverName       String?
  driverPhone      String?
  vehicleNumber    String?
  notes            String?
  organizationId   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  fromBranch       Branch          @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranch         Branch          @relation("ToBranch", fields: [toBranchId], references: [id])
  organization     Organization    @relation(fields: [organizationId], references: [id])
  alerts           DeliveryAlert[]
  co2Emissions     CO2Emission[]
}

enum DeliveryStatus {
  SCHEDULED
  PENDING
  IN_TRANSIT
  DELAYED
  PARTIAL
  DELIVERED
  CANCELLED
}

model DeliveryAlert {
  id                       String          @id @default(cuid())
  supplierDeliveryId       String?         @map("supplier_delivery_id")
  branchDeliveryId         String?         @map("branch_delivery_id")
  deliveryType             String
  alertType                AlertType
  message                  String
  isResolved               Boolean         @default(false)
  resolvedAt               DateTime?
  createdAt                DateTime        @default(now())
  organizationId           String
  
  supplierDelivery         SupplierDelivery?    @relation(fields: [supplierDeliveryId], references: [id], map: "fk_supplier_delivery_alert")
  branchDelivery           InterBranchDelivery? @relation(fields: [branchDeliveryId], references: [id], map: "fk_branch_delivery_alert")
  organization             Organization         @relation(fields: [organizationId], references: [id])
  
  @@unique([supplierDeliveryId])
  @@unique([branchDeliveryId])
}

enum AlertType {
  DELAYED
  EXPECTED_TODAY
  EXPECTED_TOMORROW
  AT_RISK
  CANCELLED
}

model DeliveryCalendar {
  id               String          @id @default(cuid())
  deliveryId       String
  deliveryType     String
  scheduledDate    DateTime
  status           DeliveryStatus
  organizationId   String
  createdAt        DateTime        @default(now())
  
  organization     Organization    @relation(fields: [organizationId], references: [id])
}

// ==================== COST OPTIMIZATION MODELS ====================

model PriceTrend {
  id             String   @id @default(cuid())
  itemId         String
  supplierId     String
  currentPrice   Float
  previousPrice  Float
  priceChange    Float
  changePercent  Float
  trendDirection String   // UP, DOWN, STABLE
  predictedPrice Float?
  confidence     Float
  analysisDate   DateTime @default(now())
  organizationId String
  
  item         InventoryItem @relation(fields: [itemId], references: [id])
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
}

model DemandForecast {
  id             String   @id @default(cuid())
  itemId         String
  branchId       String?
  forecastPeriod String   // WEEK, MONTH, QUARTER
  forecastDate   DateTime
  predictedDemand Float
  lowerBound     Float
  upperBound     Float
  confidence     Float
  factors        Json?    // seasonality, trends, events
  createdAt      DateTime @default(now())
  organizationId String
  
  item         InventoryItem @relation(fields: [itemId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
}

model StockoutRisk {
  id             String   @id @default(cuid())
  itemId         String
  branchId       String?
  riskLevel      String   // LOW, MEDIUM, HIGH, CRITICAL
  riskScore      Float
  currentStock   Float
  daysUntilStockout Int?
  reason         String
  recommendation String
  isResolved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  organizationId String
  
  item         InventoryItem @relation(fields: [itemId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
}

model WastageRecord {
  id             String   @id @default(cuid())
  itemId         String
  branchId       String?
  quantity       Float
  cost           Float
  reason         String   // SPOILAGE, DAMAGE, THEFT, EXPIRY, OVERPRODUCTION
  notes          String?
  recordedBy     String
  recordedAt     DateTime @default(now())
  organizationId String
  
  item         InventoryItem @relation(fields: [itemId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
}

model BulkOrderSaving {
  id             String   @id @default(cuid())
  itemId         String
  supplierId     String
  unitPrice      Float
  bulkQuantity   Int
  bulkPrice      Float
  savingsPerUnit Float
  totalSavings   Float
  recommended    Boolean  @default(false)
  validUntil     DateTime?
  organizationId String
